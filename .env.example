# Base URL of the EOS-backend API (includes the /api/v1 prefix).
# The backend defaults to PORT=3000, which collides with `next dev` — run the
# backend on a different port (e.g. PORT=3001 in EOS-backend/.env) or adjust
# this to wherever it's actually running.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
